{
  "name": "inzar-tarife-hesap",
  "private": true,
  "version": "1.0.8",
  "description": "İnzar Turizm Umre Tarife ve Teklif Yönetim Platformu",
  "author": "M.Hüseyin Akbalık",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhmdhsyn1453-maker/inzarturizm.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "vite build && electron-builder",
    "electron:portable": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.inzarturizm.tarifehesap",
    "productName": "İnzar Turizm Umre Tarife ve Teklif Yönetim Platformu",
    "copyright": "Copyright © 2026 İnzar Turizm",
    "publish": {
      "provider": "github",
      "owner": "mhmdhsyn1453-maker",
      "repo": "inzarturizm"
    },
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "İnzar Turizm Umre Tarife ve Teklif Yönetim Platformu",
      "uninstallDisplayName": "İnzar Turizm Umre Tarife ve Teklif Yönetim Platformu"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.7",
    "vite": "^6.1.0"
  }
}